+def test_rol_personalizado_ve_departamentos_segun_asignacion():
+    """Regresión DEF-04: el alcance es explícito. Con "Todos" ve todos, con
+    departamento solo los suyos y sin departamento asignado ninguno."""
+    from types import SimpleNamespace
+    from services.auth_service import get_departamentos_permitidos
+
+    sin_dep = SimpleNamespace(rol="consulta", departamento=None, departamentos_extra=None)
+    assert get_departamentos_permitidos(sin_dep) == []
+
+    todos = SimpleNamespace(rol="consulta", departamento="Todos", departamentos_extra=None)
+    assert get_departamentos_permitidos(todos) is None
+
+    con_dep = SimpleNamespace(rol="consulta", departamento="Producción", departamentos_extra=None)
+    assert get_departamentos_permitidos(con_dep) == ["Producción"]
+
+    # "Todos" también aplica al líder de departamento (DEF-01)
+    lider_todos = SimpleNamespace(rol="lider_departamento", departamento="Todos", departamentos_extra=None)
+    assert get_departamentos_permitidos(lider_todos) is None
+
+    # permanencia sigue sin ver cursos de docentes
+    permanencia = SimpleNamespace(rol="permanencia", departamento=None, departamentos_extra=None)
+    assert get_departamentos_permitidos(permanencia) == []
