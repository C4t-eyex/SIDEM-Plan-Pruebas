 API_seguimiento_docentes/routes/auth.py       |  8 ++--
 .../services/auth_service.py                  | 22 +++++++++-
 API_seguimiento_docentes/sql/db.sql           |  8 +++-
 API_seguimiento_docentes/tests/test_auth.py   | 43 +++++++++++++++++++
