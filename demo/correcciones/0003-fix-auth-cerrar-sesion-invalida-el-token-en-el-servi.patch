diff --git a/API_seguimiento_docentes/models/__init__.py b/API_seguimiento_docentes/models/__init__.py
index 8836aa3..ee5e49c 100644
--- a/API_seguimiento_docentes/models/__init__.py
+++ b/API_seguimiento_docentes/models/__init__.py
@@ -50,6 +50,10 @@ class Usuario(Base):
     creado_en    = Column(DateTime, server_default=func.now())
     # Migración: ALTER TABLE usuarios ADD COLUMN IF NOT EXISTS password_changed_at TIMESTAMPTZ;
     password_changed_at = Column(DateTime, nullable=True, default=None)
+    # Contador de sesión (DEF-02): va en cada token ("tv") y cerrar sesión lo
+    # incrementa, así los tokens anteriores dejan de servir sin depender de la hora.
+    # Migración: ALTER TABLE usuarios ADD COLUMN IF NOT EXISTS token_version INTEGER NOT NULL DEFAULT 0;
+    token_version = Column(Integer, nullable=False, default=0, server_default="0")
     # Restablecimiento de contraseña por correo (admin dispara el envío desde
     # Panel de Usuarios) - solo puede haber UN link vigente a la vez, uno
     # nuevo pisa al anterior. Se guarda el HASH del token, nunca el token
diff --git a/API_seguimiento_docentes/routes/auth.py b/API_seguimiento_docentes/routes/auth.py
index 393bbe4..f524e95 100644
--- a/API_seguimiento_docentes/routes/auth.py
+++ b/API_seguimiento_docentes/routes/auth.py
@@ -94,7 +94,8 @@ async def login(data: LoginRequest, request: Request, response: Response, db: Se
 
     # 4. Login exitoso — generar token
     limpiar_intentos(email)
-    token = crear_token({"sub": str(usuario.id), "rol": usuario.rol})
+    token = crear_token({"sub": str(usuario.id), "rol": usuario.rol,
+                         "tv": usuario.token_version or 0})  # DEF-02
     registrar_log(db, usuario.id, "login", f"Rol: {usuario.rol}", ip, modulo="autenticacion")
 
     # Sincronizar max_age de la cookie con el mismo valor que usó crear_token()
@@ -134,11 +135,12 @@ def logout(
     db: Session = Depends(get_db),
     access_token: Optional[str] = Cookie(default=None),
 ):
-    """Cierra la sesión eliminando la cookie."""
+    """Cierra la sesión: invalida el token en el servidor y elimina la cookie."""
     from services.log_service import registrar_log
     try:
-        from services.auth_service import get_current_user
+        from services.auth_service import get_current_user, invalidar_sesiones
         usuario = get_current_user(db, access_token)
+        invalidar_sesiones(db, usuario)  # DEF-02: el token copiado deja de servir
         registrar_log(db, usuario.id, "logout", modulo="autenticacion")
     except Exception:
         pass
diff --git a/API_seguimiento_docentes/services/auth_service.py b/API_seguimiento_docentes/services/auth_service.py
index 39227b1..36c0434 100644
--- a/API_seguimiento_docentes/services/auth_service.py
+++ b/API_seguimiento_docentes/services/auth_service.py
@@ -246,15 +246,35 @@ def get_current_user(
                 token_emitido = datetime.fromtimestamp(iat, tz=timezone.utc)
             else:
                 token_emitido = iat if getattr(iat, "tzinfo", None) else iat.replace(tzinfo=timezone.utc)
-            if token_emitido < usuario.password_changed_at:
+            invalido_desde = usuario.password_changed_at
+            if invalido_desde.tzinfo is None:  # SQLite no guarda la zona; se asume UTC
+                invalido_desde = invalido_desde.replace(tzinfo=timezone.utc)
+            if token_emitido < invalido_desde:
                 raise HTTPException(
                     status_code=status.HTTP_401_UNAUTHORIZED,
                     detail="Sesión expirada, inicia sesión nuevamente.",
                 )
 
+    # DEF-02: el token debe ser de la sesión vigente. Un token sin "tv" cuenta
+    # como versión 0 (tokens emitidos antes de este cambio).
+    if payload.get("tv", 0) != (usuario.token_version or 0):
+        raise HTTPException(
+            status_code=status.HTTP_401_UNAUTHORIZED,
+            detail="Sesión expirada, inicia sesión nuevamente.",
+        )
+
     return usuario
 
 
+def invalidar_sesiones(db: Session, usuario: Usuario) -> None:
+    """Invalida todos los tokens emitidos hasta ahora (DEF-02): incrementa el
+    contador de sesión del usuario, que va en cada token. No depende de la
+    hora, así que sirve aunque el login y el logout pasen en el mismo segundo,
+    y un login nuevo recibe la versión nueva."""
+    usuario.token_version = (usuario.token_version or 0) + 1
+    db.commit()
+
+
 def require_superadmin(usuario):
